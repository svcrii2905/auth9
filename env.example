# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas el .env real a Git ni lo incluyas en el .rar de entrega.

NODE_ENV=dev
PORT=3000

# --- Postgres local (Docker Compose) ---
POSTGRES_DB=auth_db
POSTGRES_USER=root
POSTGRES_PASSWORD=cambia_esto
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Neon / Render ---
# Si defines DATABASE_URL, tiene prioridad sobre las variables de arriba.
# DATABASE_URL=postgresql://usuario:clave@host.neon.tech/auth_db?sslmode=require

JWT_SECRET=genera_uno_nuevo_con_openssl_rand_hex_32
JWT_EXPIRES_IN=3600

# Origen del FRONTEND (Angular corre en 4200, no en 3000).
# En producción: https://tu-front.onrender.com
CORS_ORIGINS=http://localhost:4200
